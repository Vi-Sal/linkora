PORT=10000
TEMP_DIR=/tmp/linkora
MAX_FILE_SIZE_MB=100
MAX_UPLOAD_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_HEIGHT=1080
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_SIZE=5
MAX_JOBS_PER_SESSION=1
MAX_TEMP_STORAGE_MB=512
JOB_TIMEOUT_SECONDS=300
FILE_TTL_SECONDS=900
CLEANUP_INTERVAL_SECONDS=60
ENABLE_LOCAL_UPLOADS=true
ENABLE_HEAVY_TRANSCODING=true
ENABLE_DIRECT_URL_EXPORT=true
ENABLE_BATCH_EXPORT=false
MAX_BATCH_SIZE=3
# SITE_URL=https://your-service.onrender.com
# PYTHON_BIN=/absolute/path/to/venv/bin/python
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Optional Telegram alerts for completed YouTube and TikTok video and audio exports.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
